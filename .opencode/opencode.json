{
  "$schema": "https://opencode.ai/config.json",
  "username": "FRK-Dev",
  "default_agent": "build",
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Build and fix Food Roots KE codebase — 117 tests, FastAPI, traditional foods, NASA POWER, GraphRAG",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "write": "allow",
        "websearch": "allow",
        "webfetch": "allow"
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "skills": [
    ".opencode/skills/test-and-verify.skill.md",
    ".opencode/skills/expand-traditional-foods.skill.md",
    ".opencode/skills/develop-neo4j-graph.skill.md",
    ".opencode/skills/deploy-stack.skill.md"
  ],
  "experimental": {
    "primary_tools": ["read", "edit", "write", "bash", "glob", "grep", "websearch", "webfetch"]
  },
  "mcp": {
    "nasa-power": {
      "type": "remote",
      "url": "https://power.larc.nasa.gov/api",
      "enabled": true
    },
    "neo4j-cypher": {
      "type": "stdio",
      "command": "python",
      "args": [".opencode/mcp/neo4j_cypher_server.py"],
      "enabled": true
    },
    "x402": {
      "type": "stdio",
      "command": "python",
      "args": [".opencode/mcp/x402_server.py"],
      "enabled": true
    }
  }
}
