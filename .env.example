# =============================================================================
# Kienyeji - Configuration
# All values can be overridden by environment variables
# Copy to .env and fill in your secrets
# =============================================================================

# --- Database ---
DATABASE_URL=sqlite:///data/frk.db

# --- Neo4j (optional graph backend) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# --- Featherless AI (pay-as-you-go LLM inference) ---
# Leave blank to disable LLM augmentation (agents degrade gracefully)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Masumi x402 (Cardano payment channel for LLM escrow) ---
MASUMI_API_URL=https://payment-service.masumi.network
MASUMI_WALLET_ADDRESS=
MASUMI_WALLET_MNEMONIC=

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
API_KEY=
REQUEST_ID_HEADER=X-Request-ID
REQUEST_MAX_BODY_MB=10

# --- Google Maps Platform (Solar API only) ---
# Used for rooftop solar potential data (irrigation pumping, solar drying, agri-processing energy)
# Enable the Solar API in Google Cloud Console. Restrict the key by HTTP referrer.
# Leave empty to use the SVG fallback map on the dashboard
GOOGLE_MAPS_API_KEY=

# --- Data ---
DATA_DIR=data

# NOTE: NASA POWER and Open-Meteo require no API key — the clients in
# satellite/ call the public endpoints directly.
